# Load the environment for interactive shells and non-interactive SSH commands.
if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env.sh" ]; then
    . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env.sh"
fi
case $- in *i*) ;; *) return ;; esac

HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize
alias ll='ls -alF'
alias gst='git status'

if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init bash)"; fi
if command -v starship >/dev/null 2>&1; then eval "$(starship init bash)"; fi
if command -v direnv >/dev/null 2>&1; then eval "$(direnv hook bash)"; fi

# Add local aliases here without modifying the shared configuration.
if [ -r "$HOME/.bashrc.local" ]; then . "$HOME/.bashrc.local"; fi
